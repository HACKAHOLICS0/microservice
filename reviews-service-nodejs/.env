# Configuration du service
PORT=8087
APP_NAME=reviews-notification-service
NODE_ENV=development

# Configuration MongoDB - pour le développement local
MONGODB_URI=mongodb://localhost:27017/reviews-notification-service

# Configuration Eureka - pour le développement local
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# Ces variables seront écrasées par les variables d'environnement dans docker-compose.yml
